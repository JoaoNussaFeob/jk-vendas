		isHidden
		formatString: 0
		lineageTag: 048273dc-4416-41ed-8e7d-03bbeec34b1d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mês Nº]

		annotation SummarizationSetBy = Automatic

	column Mês
		dataType: string
		lineageTag: 47e2a3a6-e425-422d-9488-24af1814391b
