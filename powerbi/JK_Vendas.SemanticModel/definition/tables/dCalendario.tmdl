/// Calendário criado em DAX, do primeiro ao último dia com venda ou sobra. Marcado como tabela de datas.
table dCalendario
	lineageTag: 17742a4a-f211-46fa-84fe-43682d2d01d5
	dataCategory: Time

	column Data
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: e164e098-da2f-486f-8b8f-efd59c83b594
		summarizeBy: none
		isNameInferred
		sourceColumn: [Data]

		annotation SummarizationSetBy = Automatic

	column Ano
		dataType: int64
		formatString: 0
		lineageTag: 183e5a8b-ab5f-437c-b10f-227efec6cf28
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano]

		annotation SummarizationSetBy = Automatic

	column 'Mês Nº'
