		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano Mês Nº]

		annotation SummarizationSetBy = Automatic

	column Mês/Ano
		dataType: string
		lineageTag: c0fc1584-d096-47f1-8d50-252d0a5a30f5
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mês/Ano]
		sortByColumn: 'Ano Mês Nº'

		annotation SummarizationSetBy = Automatic

	column Dia
		dataType: int64
		formatString: 0
		lineageTag: 680a0fc3-cdce-43cd-a51f-543e428123b6
