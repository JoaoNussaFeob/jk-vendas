	column 'Tipo de Dia'
		dataType: string
		lineageTag: c177369c-ce81-4da4-b78b-dcb5a01147f8
		summarizeBy: none
		isNameInferred
		sourceColumn: [Tipo de Dia]

		annotation SummarizationSetBy = Automatic

	/// Rótulo curto para os eixos: 13/10 ter
	column 'Dia (rótulo)'
		dataType: string
		lineageTag: 9250ade1-fc2c-406f-b0a0-3218573cab5f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dia (rótulo)]
		sortByColumn: Data

		annotation SummarizationSetBy = Automatic

	hierarchy Calendário
		lineageTag: b329ba52-0d07-4dcf-95dd-f7a5471c5819

		level Ano
			lineageTag: 4ea631ea-2813-4127-83a4-2596b0f2de58
			column: Ano

		level Mês
			lineageTag: e21b036e-b9d4-4145-b266-2b4ca18c9e23
			column: Mês

		level Dia
			lineageTag: 6b3ba1bd-f748-4c5a-9f0f-306089b14a4b
			column: Dia

	partition dCalendario = calculated
		mode: import
		source =
				VAR _Datas =
					UNION (
						SELECTCOLUMNS ( fVendas, "D", fVendas[Data] ),
						SELECTCOLUMNS ( fPorcao, "D", fPorcao[Data] )
					)
				VAR _Inicio = COALESCE ( MINX ( _Datas, [D] ), DATE ( 2026, 10, 13 ) )
				VAR _Fim = COALESCE ( MAXX ( _Datas, [D] ), _Inicio )
				VAR _Base = SELECTCOLUMNS ( CALENDAR ( _Inicio, _Fim ), "Data", [Date] )
				RETURN
					ADDCOLUMNS (
						_Base,
						"Ano", YEAR ( [Data] ),
						"Mês Nº", MONTH ( [Data] ),
						"Mês", FORMAT ( [Data], "mmmm", "pt-BR" ),
						"Ano Mês Nº", YEAR ( [Data] ) * 100 + MONTH ( [Data] ),
						"Mês/Ano", FORMAT ( [Data], "mmm/yyyy", "pt-BR" ),
						"Dia", DAY ( [Data] ),
						"Dia da Semana Nº", WEEKDAY ( [Data], 2 ),
						"Dia da Semana", FORMAT ( [Data], "ddd", "pt-BR" ),
						"Tipo de Dia", IF ( WEEKDAY ( [Data], 2 ) >= 6, "Fim de semana", "Dia útil" ),
						"Dia (rótulo)", FORMAT ( [Data], "dd/mm", "pt-BR" ) & " " & FORMAT ( [Data], "ddd", "pt-BR" )
					)

	annotation PBI_Id = 131b06be437f49c2a81bbe8db5dcd28a

