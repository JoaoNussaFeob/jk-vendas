		dataType: string
		lineageTag: 7e7ee2ce-92a9-40ff-862f-d3a3fada9f67
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dia da Semana]
		sortByColumn: 'Dia da Semana Nº'

