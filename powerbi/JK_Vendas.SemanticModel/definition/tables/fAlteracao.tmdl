/// Auditoria: cada mudança de preço, quantidade preparada ou sobra (tabela registro_alteracao, preenchida pelos gatilhos).
table fAlteracao
	lineageTag: 30bb6ef6-b380-4b0a-9153-04cb81964c6f

	column Nº
		dataType: int64
		formatString: 0
		lineageTag: f76797d1-8575-4cc8-9c81-f785488abcfc
		summarizeBy: none
		sourceColumn: Nº

		annotation SummarizationSetBy = Automatic

	column Tabela
		dataType: string
		lineageTag: e68f88e7-6099-4164-8b7e-531b1d845571
		summarizeBy: none
		sourceColumn: Tabela

		annotation SummarizationSetBy = Automatic

	column Registro
		dataType: string
		lineageTag: 533afb66-345f-4d8f-ac43-16bf1d0bea23
		summarizeBy: none
		sourceColumn: Registro

		annotation SummarizationSetBy = Automatic

	column Campo
		dataType: string
		lineageTag: 8124dd99-895b-4ce1-b315-20f64c793902
		summarizeBy: none
		sourceColumn: Campo

		annotation SummarizationSetBy = Automatic

	column 'Tipo de Alteração'
		dataType: string
		lineageTag: 6762daf8-c9d5-4169-b789-85a1d23d4ef1
		summarizeBy: none
		sourceColumn: Tipo de Alteração

		annotation SummarizationSetBy = Automatic

	column 'Valor Antigo'
		dataType: string
		lineageTag: 178633df-1c51-4d4e-8a6b-806e300dffc7
		summarizeBy: none
		sourceColumn: Valor Antigo

		annotation SummarizationSetBy = Automatic

	column 'Valor Novo'
		dataType: string
		lineageTag: 71373fdc-02d5-4714-832f-2be73ab5b051
		summarizeBy: none
		sourceColumn: Valor Novo

		annotation SummarizationSetBy = Automatic

	column Usuário
		dataType: string
		lineageTag: b448c708-9eab-45c2-be6b-ae554c490b3b
		summarizeBy: none
		sourceColumn: Usuário

		annotation SummarizationSetBy = Automatic

	column 'Alterado Em'
		dataType: dateTime
		formatString: dd/mm/yyyy hh:nn
		lineageTag: e659cca5-d6b0-4a31-870d-0b739af37b9b
		summarizeBy: none
		sourceColumn: Alterado Em

		annotation SummarizationSetBy = Automatic

	partition fAlteracao = m
		mode: import
		source =
				let
					// 1. Conecta no MySQL e abre a tabela de auditoria registro_alteracao
					Fonte = MySQL.Database(Servidor, Banco, [ReturnSingleDatabase = true]),
					Tabela = Fonte{[Schema = Banco, Item = "registro_alteracao"]}[Data],
					// 2. Traduz o nome técnico da coluna alterada
					TipoAlteracao = Table.AddColumn(Tabela, "Tipo de Alteração", each
						if [campo] = "preco" then "Preço"
						else if [campo] = "kg_preparado" then "Kg preparado"
						else if [campo] = "kg_reaproveitado" then "Kg reaproveitado"
						else if [campo] = "kg_sobra" then "Kg sobra"
						else [campo], type text),
					Renomeado = Table.RenameColumns(TipoAlteracao, {
						{"id_registro", "Nº"}, {"tabela", "Tabela"}, {"registro", "Registro"}, {"campo", "Campo"},
						{"valor_antigo", "Valor Antigo"}, {"valor_novo", "Valor Novo"}, {"usuario", "Usuário"}, {"alterado_em", "Alterado Em"}}),
					Tipos = Table.TransformColumnTypes(Renomeado, {
						{"Nº", Int64.Type}, {"Tabela", type text}, {"Registro", type text}, {"Campo", type text},
						{"Valor Antigo", type text}, {"Valor Novo", type text}, {"Usuário", type text}, {"Alterado Em", type datetime}})
				in
					Tipos

	annotation PBI_ResultType = Table

